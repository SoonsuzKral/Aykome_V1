{
  "name": "aykome-e-imza",
  "version": "1.0.0",
  "description": "Aykome E-İmza Masaüstü Uygulaması",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "dev": "ELECTRON_IS_DEV=1 electron .",
    "pack": "electron-builder --dir"
  },
  "build": {
    "appId": "com.hgb.aykome.e-imza",
    "productName": "Aykome E-İmza",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Aykome E-İmza",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeader": "assets/icon.ico",
      "customProtocol": "aykome",
      "runAfterFinish": true,
      "autoLaunch": true
    },
    "mac": {
      "target": ["dmg"],
      "icon": "assets/icon.png",
      "category": "public.app-category.utilities"
    },
    "protocols": {
      "name": "Aykome E-İmza",
      "schemes": ["aykome"]
    }
  },
  "dependencies": {
    "axios": "^1.6.0",
    "electron-store": "^8.1.0",
    "node-forge": "^1.3.1",
    "node-signpdf": "^3.0.0",
    "pdf-lib": "^1.17.1",
    "pkcs11js": "^2.0.14"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  }
}
