{
  "name": "aykome-e-imza",
  "version": "1.0.0",
  "description": "Aykome E-İmza Masaüstü Uygulaması",
  "author": "HGB Bilişim",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "dev": "cross-env ELECTRON_IS_DEV=1 electron .",
    "dev:win": "set ELECTRON_IS_DEV=1&& electron .",
    "pack": "electron-builder --dir"
  },
  "build": {
    "appId": "com.hgb.aykome.e-imza",
    "productName": "Eyyübiye AYKOME - E-İmza",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "assets/**/*",
      "x64-worker/**/*"
    ],
    "extraResources": [
      {
        "from": "x64-worker",
        "to": "x64-worker"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Eyyübiye AYKOME E-İmza",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerSidebar": "assets/icon.ico",
      "runAfterFinish": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.utilities"
    },
    "protocols": {
      "name": "Eyyübiye AYKOME E-İmza",
      "schemes": [
        "aykome"
      ]
    }
  },
  "dependencies": {
    "axios": "^1.6.0",
    "electron-store": "^8.1.0",
    "form-data": "^4.0.6",
    "graphene-pk11": "^2.3.6",
    "node-forge": "^1.3.1",
    "node-signpdf": "^3.0.0",
    "pdf-lib": "^1.17.1",
    "pkcs11js": "^2.0.14"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "cross-env": "^10.1.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "sharp": "^0.35.3"
  }
}
